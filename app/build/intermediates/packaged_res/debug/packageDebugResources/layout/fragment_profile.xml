<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp" android:paddingBottom="32dp">
        <TextView android:id="@+id/av" android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/bg_circle" android:gravity="center" android:textColor="?attr/colorPrimary" android:textSize="36sp" android:textStyle="bold"/>
        <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textColor="#FFFFFF" android:textStyle="bold"/>
        <TextView android:id="@+id/email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#C7D2FE"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="#E5E7EB" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyLarge"/>
                <TextView android:id="@+id/posts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyLarge"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Button android:id="@+id/out" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="Log out"/>
    </LinearLayout>
</LinearLayout>
